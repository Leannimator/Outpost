# Copy this file to ".env" (cp .env.example .env), then fill it in. Never commit or upload ".env": it holds your passwords and keys.
# Restart Outpost after changing it. On Render, put these in the service's Environment tab instead of a file.

# --- Required ---
# The password for the owner screens. Use a long one only you know (12+ characters, not a word or your shop's name).
# Online, Outpost refuses to start if this is missing or easy to guess.
ADMIN_PASSWORD=

# --- Your public address (needed once the shop is online) ---
# Payment links, QR codes and receipts use this. Example: https://ash-and-anchor.com
BASE_URL=http://localhost:3000
PORT=3000

# --- Card payments (Stripe). Start with TEST keys (sk_test_...). ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# --- Where the database and photos live ---
# On a host with a persistent disk (Render: /var/data) set this so they survive redeploys. Leave it out on your own computer
# (the database is then "pos.db" next to server.js).
# DATA_DIR=/var/data
# Photo storage ceiling in MB (default 600).
# IMAGES_MAX_MB=600

# --- Behind a proxy (Render, Cloudflare) ---
# Number of proxies in front of Outpost so it sees the visitor's real address. Render alone: 1. Check the Security tab before changing it.
# TRUST_PROXY=1

# --- Optional: stop bots with Cloudflare Turnstile (free) ---
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Optional: your shop's timezone ---
# Dates (discount "last day", "pause sales") and reports roll over at midnight in this zone. You can also set it in Settings.
# TZ=America/Los_Angeles
